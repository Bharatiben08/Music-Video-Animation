@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Favorite Song & Animation</title>
    <style>
            /* 2. Custom CSS Styling */
            body {
                background-color: #121212;
                color: #ffffff;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                text-align: center;
                padding: 40px;
            }

            h1 {
                color: #1db954;
                margin-bottom: 20px;
            }

            .video-container {
                margin: 30px auto;
                max-width: 560px;
            }

            iframe {
                width: 100%;
                height: 315px;
                border: none;
                border-radius: 8px;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            }

            /* Animation target element */
            #animatedBox {
                width: 100px;
                height: 100px;
                background-color: #1db954;
                margin: 40px auto;
                border-radius: 8px;
                position: relative;
            }

            button {
                background-color: #1db954;
                color: white;
                border: none;
                padding: 10px 20px;
                font-size: 16px;
                border-radius: 5px;
                cursor: pointer;
            }

            button:hover {
                background-color: #1aa34a;
            }
    </style>
</head>
<body>

    <h1>My Favorite Song</h1>

    <!-- 1. Embedded YouTube Music Video -->
    <div class="video-container">
        <iframe src="https://www.youtube.com/watch?v=PeVqgynorvA&list=RDPeVqgynorvA&start_radio=1https://www.youtube.com/watch?v=PeVqgynorvA&list=RDPeVqgynorvA&start_radio=1"
                title="YouTube video player"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen>
        </iframe>
    </div>

    <h2>JavaScript Animation Demo</h2>
    <button onclick="startAnimation()">Start Animation</button>

    <!-- 3. Element to animate using JavaScript -->
    <div id="animatedBox"></div>

    <script>
            // 3. JavaScript Animation Function
            function startAnimation() {
                const elem = document.getElementById("animatedBox");
                let pos = 0;
                let direction = 1;

                // Clear any existing intervals if clicked multiple times
                clearInterval(elem.timer);

                elem.timer = setInterval(() => {
                    if (pos >= 200) {
                        direction = -1; // Move back left/up
                    } else if (pos <= 0) {
                        direction = 1;  // Move right/down
                    }
                    pos += 5 * direction;
                    elem.style.left = pos + 'px';
                    elem.style.transform = `scale(${1 + pos / 400})`; // Scales up slightly as it moves
                }, 25);
            }
    </script>

</body>
</html>